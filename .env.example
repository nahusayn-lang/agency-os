NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for outside-the-app (system) push notifications.
# Generate once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Required so the daily cron routes (deadline reminders, attendance sweep)
# can authenticate. Any long random string.
CRON_SECRET=

# Optional: email notifications (Resend)
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=Agency OS <notifications@yourdomain.com>